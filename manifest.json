{
  "name": "Navidrome Smart Plugin",
  "author": "Alexander Tyurinov",
  "version": "0.1.0",
  "description": "Generate personalized mixes for Navidrome using AudioMuse AI",
  "website": "https://github.com/rwxae/navidrome-smart-plugin",
  "config": {
    "schema": {
      "type": "object",
      "properties": {
        "audiomuse_url": {
          "type": "string",
          "title": "AudioMuse-AI URL",
          "description": "Base URL for the AudioMuse-AI server",
          "format": "uri"
        },
        "audiomuse_token": {
          "type": "string",
          "title": "AudioMuse-AI Access Token",
          "description": "Optional Bearer token for AudioMuse-AI API authentication. Leave blank if not required."
        }
      },
      "required": [
        "audiomuse_url"
      ]
    },
    "uiSchema": {
      "type": "VerticalLayout",
      "elements": [
        {
          "type": "Group",
          "label": "AuduoMuse-AI configuration",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/audiomuse_url"
            },
            {
              "type": "Control",
              "scope": "#/properties/audiomuse_token",
              "options": {
                "format": "password"
              }
            }
          ]
        }
      ]
    }
  },
  "permissions": {
    "http": {
      "reason": "To communicate with AudioMuse-AI API",
      "requiredHosts": [
        "*"
      ]
    },
    "kvstore": {
      "reason": "To store playlist IDs"
    },
    "library": {
      "reason": "To enable matcher"
    },
    "matcher": {
      "reason": "To resolve track IDs"
    },
    "scheduler": {
      "reason": "To schedule playlists generation"
    },
    "scrobbleRetriever": {
      "reason": "To analyze listening history"
    },
    "subsonicapi": {
      "reason": "To access library data and to save playlists"
    },
    "users": {
      "reason": "To access scrobbles and to save playlists"
    }
  }
}